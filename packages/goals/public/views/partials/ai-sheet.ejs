<div class="am-sheet-head">
  <div class="am-sheet-title">AI Guide</div>
  <button type="button" class="am-iconbtn" id="am-sheet-close" aria-label="Close AI guide" style="width:36px;height:36px;margin:0">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="1.8" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
  </button>
</div>

<div class="am-sheet-body" id="am-sheet-messages">
  <div class="am-bubble">Ask me about your goals, habits or progress. I can help break a goal down, spot patterns, or plan the week.</div>
</div>

<form class="am-sheet-foot" id="am-sheet-form">
  <input class="input" id="am-sheet-input" autocomplete="off"
         placeholder="Ask about your goals, habits, or progress…" aria-label="Message the AI guide">
  <button type="submit" class="btn btn-primary btn-icon" aria-label="Send">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M3 20l18-8L3 4v6l12 2-12 2z"/></svg>
  </button>
</form>
